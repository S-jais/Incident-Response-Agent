# ============================================================
# HINDSIGHTOPS ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# LLM Provider Configuration (Groq)
# Obtain from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended models: openai/gpt-oss-120b, qwen/qwen3-32b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-120b

# Hindsight Cloud / Local Memory Configuration
# Official Hindsight docs: https://hindsight.vectorize.io/
# Hindsight Cloud UI: https://ui.hindsight.vectorize.io
# Hackathon Promo Code: MEMHACK99 (Apply in Hindsight Cloud billing for $50 credits)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=hindsightops-incidents

# Server Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite default for hackathon, PostgreSQL ready)
DATABASE_URL=sqlite:///./hindsightops.db

# Demo / Fallback Settings
# Set to 'true' to allow realistic offline demo simulation when API keys are not provided
ALLOW_DEMO_FALLBACK=true
